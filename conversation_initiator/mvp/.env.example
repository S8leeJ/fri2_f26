# Copy to .env and fill in. .env is gitignored; never commit a real key.
# You only need a key for the provider you actually run.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
TYPESAFE_API_KEY=
# Jev cannot write replies. The first of groq, gemini, anthropic with a key writes them.
# Set this to pick one first.
JEV_REPLY_PROVIDER=
# Text to speech: python3 tts.py --warm, or mvp.py --tts
# Deepgram is the default. Set TTS_PROVIDER=azure to use Azure instead.
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE=
# Speech to text for the playground mic. Uses DEEPGRAM_API_KEY.
DEEPGRAM_STT_MODEL=
TTS_PROVIDER=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=
