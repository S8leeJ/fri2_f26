# Copy to .env and fill in. .env is gitignored; never commit a real key.
# You only need a key for the provider you actually run.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
TYPESAFE_API_KEY=
# Text to speech: python3 tts.py --warm, or mvp.py --tts
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=
