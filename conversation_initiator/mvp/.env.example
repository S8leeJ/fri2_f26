# Copy to .env and fill in. .env is gitignored; never commit a real key.
# You only need a key for the provider you actually run.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
TYPESAFE_API_KEY=
# Jev cannot write replies. Groq writes them, then Anthropic if Groq has no key
# or fails, then Gemini.
# Optional: a different Groq model for replies, for example openai/gpt-oss-120b
# (smarter, a little slower). Leave it empty for openai/gpt-oss-20b.
GROQ_MODEL=
# Text to speech: python3 tts.py --warm, or mvp.py --tts
# Deepgram is the default. Set TTS_PROVIDER=azure to use Azure instead.
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE=
# Speech to text for the playground mic. Uses DEEPGRAM_API_KEY.
DEEPGRAM_STT_MODEL=
TTS_PROVIDER=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=
